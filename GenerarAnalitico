def _primera_que_exista(rutas, es_carpeta=False):
    for r in rutas:
        if (os.path.isdir(r) if es_carpeta else os.path.isfile(r)):
            return r
    return None


def GenerarAnalitico(*args):
    """Punto de entrada para el botón dentro del .ods (LibreOffice)."""
    import uno  # noqa: F401

    def msgbox(texto, titulo="Generador de analíticos"):
        ctx = uno.getComponentContext()
        tk = ctx.ServiceManager.createInstanceWithContext(
            "com.sun.star.awt.Toolkit", ctx)
        tk.createMessageBox(
            None, uno.Enum("com.sun.star.awt.MessageBoxType", "INFOBOX"),
            1, titulo, texto).execute()

    ctx = uno.getComponentContext()
    desktop = ctx.ServiceManager.createInstanceWithContext(
        "com.sun.star.frame.Desktop", ctx)
    doc = desktop.getCurrentComponent()

    modelo = _primera_que_exista(MODELOS_POSIBLES)
    carpeta = _primera_que_exista(SALIDAS_POSIBLES, es_carpeta=True)
    if not modelo:
        msgbox("No encontré el modelo .odt. Revisá MODELOS_POSIBLES en el script.")
        return
    if not carpeta:
        msgbox("No encontré la carpeta de salida. Revisá SALIDAS_POSIBLES en el script.")
        return

    try:
        d = leer_todo(DatosCalc.desde_uno(doc))
    except Exception as e:
        msgbox("Error leyendo el .ods:\n%s" % e)
        return

    if not d["filas"]:
        msgbox("No hay materias cargadas en Datos!A11 en adelante.")
        return

    destino = os.path.join(carpeta, nombre_archivo(d))
    try:
        generar_odt(modelo, destino, d)
    except Exception as e:
        msgbox("Error generando el .odt:\n%s" % e)
        return

    aviso = ""
    if d["avisos"]:
        aviso = ("\n\nATENCIÓN: estas filas de la tabla tenían error de fórmula "
                 "en el .ods y salieron vacías:\n" +
                 ", ".join(str(x) for x in d["avisos"]))

    msgbox("Analítico generado con %d materias.\n\n%s%s"
           % (len(d["filas"]), destino, aviso))

    # Abrirlo para revisarlo
    url = uno.systemPathToFileUrl(destino)
    desktop.loadComponentFromURL(url, "_blank", 0, ())


