def generar_desde_archivo(ruta_ods, modelo_odt, carpeta_salida):
    """Modo terminal (para probar). No toca la hoja 'Listado'."""
    datos = DatosCalc.desde_archivo(ruta_ods)
    d = leer_todo(datos)
    carpeta = os.path.join(carpeta_salida, nombre_carpeta(d))
    if not os.path.isdir(carpeta):
        os.makedirs(carpeta)
    destino = os.path.join(carpeta, nombre_archivo(d))
    generar_odt(modelo_odt, destino, d)
    return destino, d


