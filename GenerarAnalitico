# LECTURA DE DATOS
# ---------------------------------------------------------------------------


def _col_a_indice(letras):
    n = 0
    for ch in letras.upper():
        n = n * 26 + (ord(ch) - 64)
    return n - 1


def _partir_ref(ref):
    m = re.match(r"([A-Za-z]+)(\d+)", ref)
    return _col_a_indice(m.group(1)), int(m.group(2)) - 1


class DatosCalc:
    """Acceso uniforme a las celdas, venga de UNO o de un archivo .ods."""

    def __init__(self, origen):
        self.origen = origen

    # -- desde LibreOffice abierto -----------------------------------------
    @classmethod
    def desde_uno(cls, doc):
        obj = cls("uno")
        obj.doc = doc
        return obj

    # -- desde el archivo guardado -----------------------------------------
    @classmethod
    def desde_archivo(cls, ruta_ods):
        from xml.etree import ElementTree as ET
        NS = {
            "table": "urn:oasis:names:tc:opendocument:xmlns:table:1.0",
            "office": "urn:oasis:names:tc:opendocument:xmlns:office:1.0",
            "text": "urn:oasis:names:tc:opendocument:xmlns:text:1.0",
        }

        def q(t):
            p, l = t.split(":")
            return "{%s}%s" % (NS[p], l)

        obj = cls("archivo")
        obj.hojas = {}
        with zipfile.ZipFile(ruta_ods) as z:
            root = ET.fromstring(z.read("content.xml"))
        cuerpo = root.find(q("office:body")).find(q("office:spreadsheet"))
        for t in cuerpo.findall(q("table:table")):
            nombre = t.get(q("table:name"))
            grilla = []
            for r in t.findall(q("table:table-row")):
                rep = int(r.get(q("table:number-rows-repeated")) or 1)
                fila = []
                for c in list(r):
                    if c.tag not in (q("table:table-cell"), q("table:covered-table-cell")):
                        continue
                    crep = int(c.get(q("table:number-columns-repeated")) or 1)
                    txt = "\n".join("".join(p.itertext()) for p in c.iter(q("text:p")))
                    if len(fila) + crep > 120:
                        crep = max(0, 120 - len(fila))
                    fila.extend([txt] * crep)
                    if len(fila) >= 120:
                        break
                if rep > 400:
                    rep = 1
                for _ in range(rep):
                    grilla.append(list(fila))
                    if len(grilla) >= 400:
                        break
                if len(grilla) >= 400:
                    break
            obj.hojas[nombre] = grilla
        return obj

    # ----------------------------------------------------------------------
    def celda(self, hoja, ref):
        col, fil = _partir_ref(ref)
        return self.celda_xy(hoja, col, fil)

    def celda_xy(self, hoja, col, fil):
        if self.origen == "uno":
            return self.doc.getSheets().getByName(hoja).getCellByPosition(col, fil).getString()
        grilla = self.hojas.get(hoja, [])
        if fil >= len(grilla):
            return ""
        fila = grilla[fil]
        return fila[col] if col < len(fila) else ""


# Valores de error de LibreOffice (español e inglés). Se compara el texto
# COMPLETO de la celda: así un marcador propio como "#COMPLETAR(1)#" o una
# resolución con "#" adentro no se confunden con un error de fórmula.
_ERRORES = {
    "#¡VALOR!", "#¡DIV/0!", "#¡REF!", "#¿NOMBRE?", "#N/D", "#¡NULO!", "#¡NUM!",
    "#VALUE!", "#DIV/0!", "#REF!", "#NAME?", "#N/A", "#NULL!", "#NUM!",
}
_ERR_NUMERADO = re.compile(r"^Err:\d+$")


def _es_error(texto):
    t = (texto or "").strip()
    return t in _ERRORES or bool(_ERR_NUMERADO.match(t))


def _limpiar(texto):
    """Deja vacías SOLO las celdas cuyo contenido entero es un error de fórmula."""
    t = (texto or "").strip()
    return "" if _es_error(t) else t


def leer_todo(datos):
    """Devuelve un dict con los textos y la lista de filas de la tabla."""
    d = {k: _limpiar(datos.celda(h, r)) for k, (h, r) in CELDAS.items()}
    avisos = []

    filas = []
    vacias_seguidas = 0
    for f in range(PRIMERA_FILA_DATOS - 1, ULTIMA_FILA_DATOS):
        crudas = [(datos.celda_xy("Datos", c, f) or "").strip() for c in range(6)]
        celdas = [_limpiar(x) for x in crudas]
        if any(_es_error(x) for x in crudas):
            avisos.append(f - PRIMERA_FILA_DATOS + 2)
        if not any(crudas):
            vacias_seguidas += 1
            if vacias_seguidas >= 10:
                break
            continue
        vacias_seguidas = 0
        celdas.append(crudas)          # índice 6 = valores sin limpiar
        filas.append(celdas)
    d["filas"] = filas
    d["avisos"] = avisos
    return d


