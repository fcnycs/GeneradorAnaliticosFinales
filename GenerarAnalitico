    hoja = _hoja_listado(doc)
    if hoja is None:
        return

    texto = "\n".join(armar_correo(leer_listado(hoja)))

    class Transferible(unohelper.Base, XTransferable, _TextoParaPortapapeles):
        pass

    try:
        clip = ctx.ServiceManager.createInstanceWithContext(
            "com.sun.star.datatransfer.clipboard.SystemClipboard", ctx)
        clip.setContents(Transferible(texto), None)
        _msgbox("Correo copiado al portapapeles.\nPegalo en el mail con Ctrl+V.")
    except Exception as e:
        _msgbox("No pude copiar al portapapeles (%s).\n\n"
                "Podés seleccionar la columna A de la hoja y copiarla a mano." % e)


