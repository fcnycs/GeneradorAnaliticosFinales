    _msgbox("Correo vacío. Se borraron %d analíticos." % cantidad)


class _TextoParaPortapapeles(object):
    """Envoltorio mínimo para poder poner texto en el portapapeles del sistema."""

    def __init__(self, texto):
        import uno
        from com.sun.star.datatransfer import DataFlavor
        self.texto = texto
        self.flavor = DataFlavor()
        self.flavor.MimeType = "text/plain;charset=utf-16"
        self.flavor.HumanPresentableName = "Unicode text"
        self.flavor.DataType = uno.getTypeByName("string")

    def getTransferData(self, flavor):
        return self.texto

    def getTransferDataFlavors(self):
        return (self.flavor,)

    def isDataFlavorSupported(self, flavor):
        return flavor.MimeType == self.flavor.MimeType


def CopiarCorreo(*args):
    """Botón opcional: deja el correo entero en el portapapeles."""
    import uno
    import unohelper
    from com.sun.star.datatransfer import XTransferable

    ctx = uno.getComponentContext()
    desktop = ctx.ServiceManager.createInstanceWithContext(
        "com.sun.star.frame.Desktop", ctx)
