# ARMADO DE LA TABLA
# ---------------------------------------------------------------------------

def _p(estilo, texto):
    return '<text:p text:style-name="%s">%s</text:p>' % (estilo, escape(texto))


def _celda(estilo_celda, estilo_parrafo, texto, span=0):
    at = ' table:number-columns-spanned="%d"' % span if span else ""
    xml = '<table:table-cell table:style-name="%s"%s office:value-type="string">%s</table:table-cell>' % (
        estilo_celda, at, _p(estilo_parrafo, texto))
    if span:
        xml += "<table:covered-table-cell/>" * (span - 1)
    return xml


FALTA_NOMBRE = "!!COMPLETAR NOMBRE DE LA ACTIVIDAD!!"


def es_electiva(fila):
    """Electiva = la hoja no le pone numeración (columna A vacía), o el nombre
    ya viene con el prefijo. Se mira el valor CRUDO de A: si la fórmula de la
    numeración está rota, el valor limpio quedaría vacío y confundiría la
    detección."""
    crudas = fila[6] if len(fila) > 6 else fila
    if crudas[0] == "":
        return True
    return fila[1].upper().startswith("ACTIVIDAD ELECTIVA")


def es_equivalencia(fila):
    return fila[3].upper().startswith("APROBADO POR RESOLUCION")


def armar_filas(filas):
    salida = []
    for f in filas:
        a, b, c, dd, e, ff = f[:6]
        celdas = []
        if es_electiva(f):
            # Nombre de la actividad ocupando las dos primeras columnas.
            # Si el nombre no llegó (fórmula rota en el .ods), se deja un
            # cartel bien visible en vez de una celda vacía.
            celdas.append(_celda("AFcelA", "AFIzq", b or FALTA_NOMBRE, span=2))
        else:
            celdas.append(_celda("AFcelA", "AFCentro", a))
            celdas.append(_celda("AFcelB", "AFIzq", b))

        celdas.append(_celda("AFcelC", "AFCentro", c))

        if es_equivalencia(f):
            # La resolución ocupa CALIFICACIÓN + LIBRO + FOLIO
            celdas.append(_celda("AFcelF", "AFCentro", dd, span=3))
        else:
            celdas.append(_celda("AFcelD", "AFCentro", dd))
            celdas.append(_celda("AFcelE", "AFCentro", e))
            celdas.append(_celda("AFcelF", "AFCentro", ff))

        salida.append('<table:table-row table:style-name="AFfila">%s</table:table-row>'
                      % "".join(celdas))
    return "".join(salida)



# ---------------------------------------------------------------------------
# CABECERA: "Hoja Nº N - Certificado Analítico APELLIDO, NOMBRES (DNI N°...)"
# ---------------------------------------------------------------------------

ESTILO_HOJA = """<style:style style:name="AFHoja" style:family="paragraph" style:parent-style-name="Standard">
 <style:paragraph-properties fo:margin-top="0.15cm" fo:margin-bottom="0cm" fo:text-align="start"/>
 <style:text-properties style:font-name="{fuente}" fo:font-size="10pt"/>
</style:style>"""


def _parrafo_hoja(alumno):
    return ('<text:p text:style-name="AFHoja">Hoja N\u00ba '
            '<text:page-number text:select-page="current">2</text:page-number>'
            ' - Certificado Anal\u00edtico %s</text:p>' % escape(alumno))


def poner_renglon_hoja(styles_xml, alumno):
    """Agrega el renglón de hoja a la cabecera de página, salvo en la primera.

    Se apoya en <style:header-first>, que es la opción "Mismo contenido en la
    primera página" de Writer: la primera hoja queda como está y de la segunda
    en adelante aparece el renglón con el número de hoja y el alumno.
    """
    m = re.search(r'<style:header>(.*?)</style:header>', styles_xml, re.DOTALL)
    if not m:
        return styles_xml            # el modelo no tiene cabecera: no toco nada
    cabecera = m.group(1)

    # Primero se reemplaza la cabecera (usando las posiciones ya calculadas)
    nueva = ("<style:header>" + cabecera + _parrafo_hoja(alumno) + "</style:header>"
             + "<style:header-first>" + cabecera + "</style:header-first>")
    styles_xml = styles_xml[:m.start()] + nueva + styles_xml[m.end():]

    # y recién después se agrega el estilo, que va más arriba en el archivo
    return styles_xml.replace(
        "</office:automatic-styles>",
        ESTILO_HOJA.format(fuente=FUENTE) + "</office:automatic-styles>", 1)


# ---------------------------------------------------------------------------
# GENERACIÓN DEL .ODT
# ---------------------------------------------------------------------------

def _sin_guiones(texto):
    """Saca los guiones de relleno del final (los pone Writer con el tabulador)."""
    return re.sub(r"[-\s]*$", "", texto).rstrip(".")


def _parrafo_pie(texto):
    return '<text:p text:style-name="AFPie">%s.<text:tab/></text:p>' % escape(texto)


def reemplazar_parrafo_certifico(xml, texto):
    """Cambia el párrafo del modelo que contiene CERTIFICO por el texto real.

    Conserva el estilo de párrafo que tenga el modelo, sea cual sea su nombre.
    """
    inicio_tabla = xml.find("<table:table")
    zona = xml[:inicio_tabla] if inicio_tabla > 0 else xml
    for m in re.finditer(r'<text:p\b([^>]*)>(.*?)</text:p>', zona, re.DOTALL):
        plano = re.sub(r"<[^>]+>", "", m.group(2))
        if "CERTIFICO" in plano.upper():
            estilo = re.search(r'text:style-name="([^"]+)"', m.group(1))
            nuevo = '<text:p%s>%s</text:p>' % (
                ' text:style-name="%s"' % estilo.group(1) if estilo else "",
                escape(texto))
            return xml[:m.start()] + nuevo + xml[m.end():]
    raise RuntimeError(
        "No encontré en el modelo el párrafo que empieza con CERTIFICO. "
        "¿Se editó el modelo y se borró ese texto?")


def generar_odt(modelo_odt, salida_odt, d):
    with zipfile.ZipFile(modelo_odt) as z:
        nombres = z.namelist()
        contenidos = {n: z.read(n) for n in nombres}

    xml = contenidos["content.xml"].decode("utf-8")

    # 1) estilos nuevos
    xml = xml.replace("</office:automatic-styles>",
                      ESTILOS_NUEVOS + "</office:automatic-styles>")

    # 2) párrafo de CERTIFICO: se lo ubica por su contenido, porque el nombre
    #    del estilo cambia si alguien abre y guarda el modelo con LibreOffice.
    xml = reemplazar_parrafo_certifico(xml, d["parrafo"])

    # 3) tabla: cabecera del modelo + filas generadas
    m = re.search(r'(<table:table\b[^>]*table:name="Tabla1"[^>]*>)(.*?)(</table:table>)',
                  xml, re.DOTALL)
    cuerpo = m.group(2)
    columnas = "".join(re.findall(r'<table:table-column\b[^>]*/>', cuerpo))
    fila_cabecera = re.search(r'<table:table-row\b.*?</table:table-row>', cuerpo, re.DOTALL).group(0)

    tabla = (m.group(1) + columnas
             + "<table:table-header-rows>" + fila_cabecera + "</table:table-header-rows>"
             + armar_filas(d["filas"])
             + m.group(3))
    xml = xml[:m.start()] + tabla + xml[m.end():]

    # 4) pie del documento
    cierre = (d["cierre_1"].rstrip() + " " + d["cierre_2"].lstrip()).strip()
    pie = "".join([
        _parrafo_pie(_sin_guiones(d["fecha_egreso"])),
        _parrafo_pie(_sin_guiones(d["promedio"])),
        _parrafo_pie(_sin_guiones(d["escala"])),
        _parrafo_pie(_sin_guiones(cierre)),
    ])
    xml = re.sub(r'(</table:table>)(.*?)(</office:text>)',
                 lambda mm: mm.group(1) + '<text:p text:style-name="AFPie"/>' + pie + mm.group(3),
                 xml, count=1, flags=re.DOTALL)

    contenidos["content.xml"] = xml.encode("utf-8")

    # Renglón de hoja en la cabecera, de la página 2 en adelante
    alumno = "%s, %s (DNI N°%s)" % (d["apellido"].upper(), d["nombres"].upper(),
                                    _dni_con_puntos(d["dni"]))
    contenidos["styles.xml"] = poner_renglon_hoja(
        contenidos["styles.xml"].decode("utf-8"), alumno).encode("utf-8")

    with zipfile.ZipFile(salida_odt, "w", zipfile.ZIP_DEFLATED) as z:
        # mimetype va primero y sin comprimir
        z.writestr(zipfile.ZipInfo("mimetype"), contenidos["mimetype"],
                   compress_type=zipfile.ZIP_STORED)
        for n in nombres:
            if n == "mimetype":
                continue
            z.writestr(n, contenidos[n])
    return salida_odt


def _dni_con_puntos(dni):
    dni = re.sub(r"\D", "", dni or "")
    return "{}.{}.{}".format(dni[:-6], dni[-6:-3], dni[-3:]) if len(dni) >= 7 else dni


def nombre_archivo(d):
    return "Analitico Final - %s, %s (DNI N°%s).odt" % (
        d["apellido"].upper(), d["nombres"].upper(), _dni_con_puntos(d["dni"]))


def nombre_carpeta(d):
    """Carpeta por alumno, con el mismo formato que usaba la macro vieja:
    'APELLIDO, NOMBRES - 45458789'"""
    dni = re.sub(r"\D", "", d["dni"])
    return "%s, %s - %s" % (d["apellido"].upper(), d["nombres"].upper(), dni)


def linea_listado(d):
    """Alumno tal como va en el correo: igual al nombre del archivo, sin el
    prefijo "Analitico Final - " y sin la extensión."""
    return "%s, %s (DNI N°%s)" % (d["apellido"].upper(), d["nombres"].upper(),
                                  _dni_con_puntos(d["dni"]))


# ---------------------------------------------------------------------------
# HOJA "LISTADO"
# ---------------------------------------------------------------------------

SALUDO = ["Hola buen día,", "Adjunto Certificado Analitico de los siguientes:"]
DESPEDIDA = "Saludos cordiales,"

# Cuántas filas de la columna A se revisan / limpian
MAX_FILAS_LISTADO = 500

_RE_ENTRADA_NUEVA = re.compile(r"^\d+\s*-\s*(.+)$")
_RE_ENTRADA_VIEJA = re.compile(r"^-\s*(.+?)\s*-\s*(\d{6,9})$")


def _texto_columna_a(hoja):
    """Devuelve la columna A como lista de textos, hasta la última fila usada."""
    filas, ultima = [], -1
    for f in range(MAX_FILAS_LISTADO):
        t = hoja.getCellByPosition(0, f).getString().strip()
        filas.append(t)
        if t:
            ultima = f
        elif f - ultima > 30:
            break
    return filas[:ultima + 1]


def leer_listado(hoja):
    """Reconstruye el listado como [(carrera, [alumnos])] leyendo la columna A.

    Entiende tanto el formato nuevo ("01 - APELLIDO, NOMBRES (DNI N°...)")
    como el que dejó la macro anterior ("- APELLIDO, NOMBRES - 12345678").
    """
    sic = []                       # secciones: lista de [carrera, [alumnos]]
    for texto in _texto_columna_a(hoja):
        if not texto or texto in SALUDO or texto == DESPEDIDA:
            continue
        m = _RE_ENTRADA_NUEVA.match(texto)
        if m:
            alumno = m.group(1).strip()
        else:
            m = _RE_ENTRADA_VIEJA.match(texto)
            if m:
                alumno = "%s (DNI N°%s)" % (m.group(1).strip(),
                                            _dni_con_puntos(m.group(2)))
            elif texto.endswith(":"):
                carrera = texto[:-1].strip()
                if not sic or sic[-1][0] != carrera:
                    sic.append([carrera, []])
                continue
            else:
                continue           # cualquier otra cosa se ignora
        if not sic:
            sic.append(["", []])
        if alumno not in sic[-1][1]:
            sic[-1][1].append(alumno)
    return sic


def armar_correo(secciones):
    """Arma el texto completo del correo a partir de las secciones."""
    lineas = list(SALUDO)
    for carrera, alumnos in secciones:
        if not alumnos:
            continue
        lineas.append("")
        lineas.append((carrera or "SIN CARRERA") + ":")
        for i, alumno in enumerate(alumnos, start=1):
            lineas.append("%02d - %s" % (i, alumno))
    lineas.append("")
    lineas.append(DESPEDIDA)
    return lineas


def escribir_listado(hoja, secciones):
    """Vuelca el correo en la columna A, borrando antes lo que hubiera."""
    lineas = armar_correo(secciones)
    usadas = len(_texto_columna_a(hoja))
    for f in range(max(usadas, len(lineas))):
        hoja.getCellByPosition(0, f).setString(lineas[f] if f < len(lineas) else "")
    return lineas


def actualizar_listado(doc, d):
    """Agrega el alumno al correo de la hoja 'Listado' y lo renumera.

    Devuelve un texto para el cartel final.
    """
    alumno = linea_listado(d)
    carrera = (d.get("carrera") or "").strip().upper()

    hoja = doc.getSheets().getByName("Listado")
    secciones = leer_listado(hoja)

    # ¿ya estaba en alguna sección?
    for _, alumnos in secciones:
        if alumno in alumnos:
            return "Ya figuraba en el correo, no lo repetí."

    # sección sin nombre (la que dejó la macro vieja): se le pone la carrera
    for sec in secciones:
        if not sec[0] and carrera:
            sec[0] = carrera
            break

    for sec in secciones:
        if sec[0] == carrera:
            sec[1].append(alumno)
            break
    else:
        secciones.append([carrera, [alumno]])

    escribir_listado(hoja, secciones)
    total = sum(len(a) for _, a in secciones)
    return "Agregado al correo bajo '%s' (%d en total)." % (carrera or "SIN CARRERA", total)


