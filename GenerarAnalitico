PRIMERA_FILA_LISTADO = 3   # índice 3 = fila 4 de Calc (debajo de "Adjunto...")


def _ultima_fila_listado(hoja):
    """Última fila con texto en la columna A (índice; -1 si está vacía)."""
    ultima = -1
    for f in range(0, 2000):
        if hoja.getCellByPosition(0, f).getString().strip():
            ultima = f
        elif f - ultima > 30:
            break
    return ultima


def _copiar_formato(hoja, fila_origen, fila_destino):
    try:
        o = hoja.getCellByPosition(0, fila_origen)
        de = hoja.getCellByPosition(0, fila_destino)
        de.CharFontName = o.CharFontName
        de.CharHeight = o.CharHeight
        de.CharWeight = o.CharWeight
        de.HoriJustify = o.HoriJustify
    except Exception:
        pass


def actualizar_listado(doc, d):
    """Agrega el alumno al 'Listado', agrupado por carrera.

    Devuelve un texto para mostrar en el cartel final.
    """
    entrada = linea_listado(d)
    carrera = (d.get("carrera") or "").strip().upper()
    encabezado = (carrera + ":") if carrera else ":"

    hoja = doc.getSheets().getByName("Listado")
    ultima = _ultima_fila_listado(hoja)

    # ¿ya estaba cargado?
    for f in range(PRIMERA_FILA_LISTADO, ultima + 1):
        if hoja.getCellByPosition(0, f).getString().strip() == entrada:
            return "Ya figuraba en el Listado, no lo repetí."

    # Buscar el último encabezado de sección ("CARRERA:")
    fila_seccion, texto_seccion = None, None
    for f in range(PRIMERA_FILA_LISTADO, ultima + 1):
        t = hoja.getCellByPosition(0, f).getString().strip()
        if t and not t.startswith("-"):
            fila_seccion, texto_seccion = f, t

    if ultima < PRIMERA_FILA_LISTADO:
        # La lista está vacía: encabezado + primer alumno
        hoja.getCellByPosition(0, PRIMERA_FILA_LISTADO).setString(encabezado)
        hoja.getCellByPosition(0, PRIMERA_FILA_LISTADO + 1).setString(entrada)
        return "Agregado al Listado, sección nueva '%s'." % encabezado

    if texto_seccion in (None, "", ":"):
        # Había un encabezado vacío (el bug de la macro vieja): lo completo
        if fila_seccion is not None:
            hoja.getCellByPosition(0, fila_seccion).setString(encabezado)
        hoja.getCellByPosition(0, ultima + 1).setString(entrada)
        _copiar_formato(hoja, ultima, ultima + 1)
        return "Agregado al Listado (completé el encabezado '%s')." % encabezado

    if texto_seccion == encabezado:
        # Misma carrera: va al final de la sección actual
        hoja.getCellByPosition(0, ultima + 1).setString(entrada)
        _copiar_formato(hoja, ultima, ultima + 1)
        return "Agregado al Listado, bajo '%s'." % encabezado

    # Carrera distinta: renglón en blanco + encabezado nuevo + alumno
    hoja.getCellByPosition(0, ultima + 2).setString(encabezado)
    hoja.getCellByPosition(0, ultima + 3).setString(entrada)
    _copiar_formato(hoja, fila_seccion, ultima + 2)
    _copiar_formato(hoja, ultima, ultima + 3)
    return "Agregado al Listado, sección nueva '%s'." % encabezado


