# Carpetas donde buscar el modelo. Se usa el "Analitico Final - 00MODELO<año>.odt"
# del año más alto que haya: el año que viene alcanza con dejar ahí el
# 00MODELO2027.odt y el script lo toma solo, sin tocar nada.
CARPETAS_MODELO = [
    r"D:\Documentos Personales\ALUMNOS\Analitico p-titulo",
    "/home/cristian/Documentos/ALUMNOS/Analitico p-titulo",
]
# Cualquier .odt que tenga "MODELO" en el nombre. Si además tiene un año de 4
# cifras, se usa para elegir el más nuevo cuando hay varios.
PATRON_MODELO = re.compile(r"MODELO.*\.odt$", re.IGNORECASE)
PATRON_ANIO = re.compile(r"(20\d{2})")
SALIDAS_POSIBLES = [
    r"D:\Documentos Personales\ALUMNOS\Analitico p-titulo\Para enviar",
    "/home/cristian/Documentos/ALUMNOS/Analitico p-titulo/Para enviar",
]


def _primera_que_exista(rutas, es_carpeta=False):
    for r in rutas:
        if (os.path.isdir(r) if es_carpeta else os.path.isfile(r)):
            return r
    return None


def carpeta_del_ods(doc):
    """Carpeta donde está guardado el .ods abierto (o None si nunca se guardó)."""
    try:
        import uno
        url = doc.getURL()
        if url:
            return os.path.dirname(uno.fileUrlToSystemPath(url))
    except Exception:
        pass
    return None


def carpetas_a_revisar(doc=None):
    """Dónde buscar el modelo: primero al lado del .ods, después lo configurado.

    Así no hace falta editar rutas en el script: si el modelo está en la misma
    carpeta que el generador (o en su subcarpeta "Para enviar"), lo encuentra.
    """
    carpetas = []
    base = carpeta_del_ods(doc) if doc is not None else None
    if base:
        carpetas += [base, os.path.join(base, "Para enviar"), os.path.dirname(base)]
    carpetas += CARPETAS_MODELO
    vistas, salida = set(), []
    for c in carpetas:
        if c and c not in vistas and os.path.isdir(c):
            vistas.add(c)
            salida.append(c)
    return salida


def buscar_modelo(doc=None):
    """Devuelve el modelo más nuevo que encuentre, y las carpetas revisadas."""
    revisadas = carpetas_a_revisar(doc)
    encontrados = []
    for carpeta in revisadas:
        try:
            nombres = os.listdir(carpeta)
        except Exception:
            continue
        for nombre in nombres:
            if not PATRON_MODELO.search(nombre):
                continue
            anio = PATRON_ANIO.search(nombre)
            encontrados.append((int(anio.group(1)) if anio else 0,
                                os.path.join(carpeta, nombre)))
    ruta = max(encontrados)[1] if encontrados else None
    return ruta, revisadas


