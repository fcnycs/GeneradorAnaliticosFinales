def _primera_que_exista(rutas, es_carpeta=False):
    for r in rutas:
        if (os.path.isdir(r) if es_carpeta else os.path.isfile(r)):
            return r
    return None


def _msgbox(texto, titulo="Generador de analíticos", tipo="INFOBOX"):
    import uno
    ctx = uno.getComponentContext()
    tk = ctx.ServiceManager.createInstanceWithContext("com.sun.star.awt.Toolkit", ctx)
    return tk.createMessageBox(
        None, uno.Enum("com.sun.star.awt.MessageBoxType", tipo),
        1, titulo, texto).execute()


def _preguntar(texto, titulo="Generador de analíticos"):
    """Cartel Sí/No. Devuelve True si el usuario elige Sí."""
    import uno
    ctx = uno.getComponentContext()
    tk = ctx.ServiceManager.createInstanceWithContext("com.sun.star.awt.Toolkit", ctx)
    caja = tk.createMessageBox(
        None, uno.Enum("com.sun.star.awt.MessageBoxType", "QUERYBOX"),
        2, titulo, texto)   # 2 = botones Sí / No
    return caja.execute() == 2   # 2 = Sí


def GenerarAnalitico(*args):
    """Botón principal: genera el .odt en su carpeta y actualiza el Listado."""
    import uno

    ctx = uno.getComponentContext()
    desktop = ctx.ServiceManager.createInstanceWithContext(
        "com.sun.star.frame.Desktop", ctx)
    doc = desktop.getCurrentComponent()

    modelo = _primera_que_exista(MODELOS_POSIBLES)
    base = _primera_que_exista(SALIDAS_POSIBLES, es_carpeta=True)
    if not modelo:
        _msgbox("No encontré el modelo .odt. Revisá MODELOS_POSIBLES en el script.")
        return
    if not base:
        _msgbox("No encontré la carpeta de salida. Revisá SALIDAS_POSIBLES en el script.")
        return

    try:
        d = leer_todo(DatosCalc.desde_uno(doc))
    except Exception as e:
        _msgbox("Error leyendo el .ods:\n%s" % e)
        return

    if not d["filas"]:
        _msgbox("No hay materias cargadas en Datos!A11 en adelante.")
        return

    # Carpeta propia del alumno, adentro de "Para enviar"
    carpeta = os.path.join(base, nombre_carpeta(d))
    destino = os.path.join(carpeta, nombre_archivo(d))
    try:
        if not os.path.isdir(carpeta):
            os.makedirs(carpeta)
        generar_odt(modelo, destino, d)
    except Exception as e:
        _msgbox("Error generando el .odt:\n%s" % e)
        return

    # Listado para el correo
    try:
        nota_listado = actualizar_listado(doc, d)
    except Exception as e:
        nota_listado = "No pude actualizar el Listado: %s" % e

    aviso = ""
    if d["avisos"]:
        aviso = ("\n\nATENCIÓN: estas filas de la tabla tenían error de fórmula "
                 "en el .ods y salieron vacías:\n" +
                 ", ".join(str(x) for x in d["avisos"]))

    _msgbox("Analítico generado con %d materias.\n\n%s\n\n%s\n"
            "(Acordate de guardar el .ods para conservar el Listado.)%s"
            % (len(d["filas"]), destino, nota_listado, aviso))

    desktop.loadComponentFromURL(uno.systemPathToFileUrl(destino), "_blank", 0, ())


def LimpiarListado(*args):
    """Botón de la hoja 'Listado': borra los nombres para arrancar el próximo correo."""
    import uno

    ctx = uno.getComponentContext()
    desktop = ctx.ServiceManager.createInstanceWithContext(
        "com.sun.star.frame.Desktop", ctx)
    doc = desktop.getCurrentComponent()

    try:
        hoja = doc.getSheets().getByName("Listado")
    except Exception as e:
        _msgbox("No encontré la hoja 'Listado':\n%s" % e)
        return

    ultima = _ultima_fila_listado(hoja)
    if ultima < PRIMERA_FILA_LISTADO:
        _msgbox("El Listado ya está vacío.")
        return

    cantidad = sum(
        1 for f in range(PRIMERA_FILA_LISTADO, ultima + 1)
        if hoja.getCellByPosition(0, f).getString().strip().startswith("-"))

    if not _preguntar("Se van a borrar %d analíticos del Listado.\n"
                      "Las dos primeras líneas del correo quedan intactas.\n\n"
                      "¿Confirmás?" % cantidad):
        return

    # 1=valor, 2=fecha/hora, 4=texto, 16=fórmula
    rango = hoja.getCellRangeByPosition(0, PRIMERA_FILA_LISTADO, 5, ultima)
    rango.clearContents(1 + 2 + 4 + 16)

    _msgbox("Listado limpio. Se borraron %d analíticos." % cantidad)


