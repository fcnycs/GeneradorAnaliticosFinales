import uno
import re
import os
import sys
import pdfplumber
from urllib.parse import urlparse, unquote

def uno_url_to_path(url):
    """
    Convierte una URL de LibreOffice (file://...) a una ruta de sistema.
    Funciona en Windows y Linux.
    """
    parsed = urlparse(url)
    path = unquote(parsed.path)
    # En Windows, urlparse deja una barra extra al inicio antes de la letra de unidad
    # Ejemplo: file:///D:/carpeta/archivo.pdf -> /D:/carpeta/archivo.pdf
    # Hay que sacar esa barra para que quede D:/carpeta/archivo.pdf
    if sys.platform.startswith('win') and re.match(r'^/[A-Za-z]:', path):
        path = path[1:]
    return path

def msgbox(message):
    """
    Muestra un cuadro de diálogo simple en LibreOffice.
    """
    ctx = uno.getComponentContext()
    smgr = ctx.ServiceManager
    toolkit = smgr.createInstanceWithContext("com.sun.star.awt.Toolkit", ctx)
    box = toolkit.createMessageBox(
        None,
        uno.Enum("com.sun.star.awt.MessageBoxType", "INFOBOX"),
        1,
        "Información",
        message
    )
    box.execute()

def limpiar_registro(record):
    """
    Limpia el registro removiendo patrones no deseados derivados de cortes de página,
    numeración o indicaciones del certificado.
    """
    prefix = ""
    prefix_match = re.match(r'^([A-Za-z0-9]+(?:\s*-\s*))', record)
    if prefix_match:
        prefix = prefix_match.group(1)
        record = record[len(prefix):]
    
    if "Página" in record and "Certificado analitico" in record:
        pattern = re.compile(
            r'^(?P<subject1>.+?)\s*Página\s+\d+\s+de\s+\d+\s*-\s*Certificado\s+analitico\s+de\s+.*?\)\s*(?P<subject2>.+)$',
            flags=re.IGNORECASE
        )
        m = pattern.search(record)
        if m:
            record = m.group("subject1").strip() + " " + m.group("subject2").strip()
    
    record = re.sub(r'Página\s+\d+\s+de\s+\d+', '', record, flags=re.IGNORECASE)
    
    # Red de seguridad: si por algún motivo "certificado en <ciudad>" terminó
    # adentro de un registro, recortar todo desde ahí en adelante.
    cert_match = re.search(r'\s+certificado\s+en\s+', record, re.IGNORECASE)
    if cert_match:
        record = record[:cert_match.start()].strip()
    
    footer_indicators = ["estudios cursados", "actividades cursadas"]
    for indicator in footer_indicators:
        pos = record.lower().find(indicator)
        if pos != -1:
            record = record[:pos].strip()
            break

    if not re.search(r'\b\d{2}/\d{2}/\d{4}\b', record):
        footer_keywords = [
            "resultado", "a pedido del interesado", "se expide",
            "certificado analitico", "sello", "firma"
        ]
        for kw in footer_keywords:
            pos = record.lower().find(kw.lower())
            if pos != -1:
                record = record[:pos].strip()
                break
    
    cleaned = " ".join(record.split())
    return prefix + cleaned

def extract_fields(record):
    """
    Extrae los campos del registro en 7 columnas.
    """
    record = " ".join(record.split())
    
    date_match = re.search(r'\b(\d{2}/\d{2}/\d{4})\b', record)
    if not date_match:
        return None
    
    actividades = record[:date_match.start()].strip()
    fecha = date_match.group(1)
    remainder = record[date_match.end():].strip()
    
    col_c = ""
    col_d = ""
    col_e = ""
    col_f = ""
    col_g = ""
    
    tokens = remainder.split()
    if not tokens:
        return None
    
    idx = 0
    
    if idx < len(tokens):
        if tokens[idx] in ["Aprobado", "Ausente"]:
            col_c = tokens[idx]
            idx += 1
            
            if idx < len(tokens) and tokens[idx] in ["Equivalencia", "Examen", "Promoción"]:
                col_d = tokens[idx]
                idx += 1
                
                if col_d == "Equivalencia":
                    resolucion_parts = []
                    if idx < len(tokens) and tokens[idx] == "DFCNyCS":
                        resolucion_parts.append(tokens[idx])
                        idx += 1
                        
                        while idx < len(tokens):
                            token = tokens[idx]
                            if re.search(r'\d', token) or token == "/":
                                resolucion_parts.append(token)
                                idx += 1
                                if re.search(r'\d+/\d+', " ".join(resolucion_parts)):
                                    break
                            else:
                                break
                        
                        col_e = " ".join(resolucion_parts)
                
                elif col_d in ["Examen", "Promoción"]:
                    if idx < len(tokens):
                        col_e = tokens[idx]
                        idx += 1
                    if idx < len(tokens):
                        col_f = tokens[idx]
                        idx += 1
                    if idx < len(tokens):
                        col_g = tokens[idx]
                        idx += 1
            
        elif re.match(r'^\d+$', tokens[idx]) or re.match(r'^\d+\(', tokens[idx]):
            if re.match(r'^\d+$', tokens[idx]):
                col_c = tokens[idx]
                idx += 1
                paren_parts = []
                while idx < len(tokens):
                    if tokens[idx].startswith('('):
                        paren_parts.append(tokens[idx])
                        if tokens[idx].endswith(')'):
                            idx += 1
                            break
                        idx += 1
                    elif paren_parts and not tokens[idx-1].endswith(')'):
                        paren_parts.append(tokens[idx])
                        if tokens[idx].endswith(')'):
                            idx += 1
                            break
                        idx += 1
                    else:
                        break
                if paren_parts:
                    col_c += " " + " ".join(paren_parts)
            else:
                col_c = tokens[idx]
                idx += 1
            
            if idx < len(tokens) and tokens[idx] in ["Examen", "Promoción"]:
                col_d = tokens[idx]
                idx += 1
            
            if idx < len(tokens):
                col_e = tokens[idx]
                idx += 1
            if idx < len(tokens):
                col_f = tokens[idx]
                idx += 1
            if idx < len(tokens):
                col_g = tokens[idx]
                idx += 1
    
    return {
        "actividades": actividades.strip(),
        "fecha": fecha,
        "col_c": col_c,
        "col_d": col_d,
        "col_e": col_e,
        "col_f": col_f,
        "col_g": col_g
    }

def ExtraerDatos(*args):
    ctx = uno.getComponentContext()
    smgr = ctx.ServiceManager
    desktop = smgr.createInstanceWithContext("com.sun.star.frame.Desktop", ctx)
    doc = desktop.getCurrentComponent()
    
    # 1. Seleccionar el PDF
    filePicker = smgr.createInstanceWithContext("com.sun.star.ui.dialogs.FilePicker", ctx)
    filePicker.setTitle("Seleccionar archivo PDF")
    filePicker.appendFilter("Archivos PDF (*.pdf)", "*.pdf")
    # Carpeta por defecto donde se guardan los PDFs de los analíticos.
    # Probamos rutas posibles según el sistema; si ninguna existe, el FilePicker
    # abrirá en la última carpeta usada o en una por defecto del sistema.
    try:
        rutas_posibles = [
            r"D:\Documentos Personales\Downloads\PDFS para extraer (Analiticos)",  # Casa (Windows)
            "/home/cristian/Documentos/ALUMNOS/Analitico p-titulo/PDFs y Excel para copiar",  # Trabajo (Linux)
        ]
        for ruta in rutas_posibles:
            if os.path.isdir(ruta):
                # Normalizar a URL file:/// (en Windows hay que escapar las barras invertidas)
                ruta_normalizada = ruta.replace("\\", "/")
                default_dir_url = "file:///" + ruta_normalizada.lstrip("/")
                filePicker.setDisplayDirectory(default_dir_url)
                break
    except Exception:
        pass
    
    if filePicker.execute() != 1:
        msgbox("Operación cancelada. No se seleccionó ningún archivo.")
        return
    
    fileURLs = filePicker.getFiles()
    if not fileURLs or len(fileURLs) == 0:
        msgbox("No se seleccionó ningún archivo.")
        return
    
    fileUrl = fileURLs[0]
    filePath = uno_url_to_path(fileUrl)
    
    # 2. Abrir el PDF y extraer el texto (a partir del encabezado)
    try:
        pdf = pdfplumber.open(filePath)
    except Exception as e:
        msgbox("No se pudo abrir el PDF:\n" + str(e) + "\n\nRuta interpretada:\n" + filePath)
        return
    
    dni = None
    apellido = None
    nombres = None
    genero = None  # "el Sr. " o "la Srta. " (con espacio final, como espera Datos.V4)
    
    dni_pattern = re.compile(r'\( *DNI *(\d{8}) *\)', re.IGNORECASE)
    # Captura: "el alumno APELLIDO, NOMBRES ( DNI ..." o "la alumna APELLIDO, NOMBRES ( DNI ..."
    # El apellido puede tener varias palabras (apellidos compuestos). El nombre también.
    # Cortamos al llegar a la coma (para apellido) y al "(" del DNI (para nombres).
    persona_pattern = re.compile(
        r'(?P<tipo>el\s+alumno|la\s+alumna)\s+'
        r'(?P<apellido>[^,()]+?)\s*,\s*'
        r'(?P<nombres>[^,()]+?)\s*\(\s*DNI',
        re.IGNORECASE
    )
    
    data_lines = []
    header_found = False
    
    for page in pdf.pages:
        page_text = page.extract_text() or ""
        if "Certificado Analítico Parcial" in page_text:
            header_found = True
        if header_found and dni is None:
            m = dni_pattern.search(page_text)
            if m:
                dni = m.group(1)
        if header_found and apellido is None:
            # Normalizar saltos de línea (a veces el bloque viene partido en dos renglones)
            texto_plano = " ".join(page_text.split())
            m = persona_pattern.search(texto_plano)
            if m:
                apellido = m.group("apellido").strip()
                nombres = m.group("nombres").strip()
                tipo = m.group("tipo").lower().strip()
                if "alumna" in tipo:
                    genero = "la Srta. "
                else:
                    genero = "el Sr. "
        lines = page_text.splitlines()
        if not data_lines:
            for i, line in enumerate(lines):
                if "Actividades Rendidas" in line and "Fecha" in line:
                    data_lines.extend(lines[i+1:])
                    break
        else:
            data_lines.extend(lines)
    pdf.close()
    
    if not header_found:
        msgbox("No se encontró la sección 'Certificado Analítico Parcial'.")
        return
    
    msgbox("Cantidad total de líneas recolectadas: " + str(len(data_lines)))
    
    # 3. Agrupar las líneas en registros.
    registros = []
    registro_actual = ""
    subject_start_re = re.compile(r'^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\s*-\s*')
    
    # Patrón que marca el fin del documento (pie de página final).
    # Cuando aparece "certificado en <CIUDAD>" significa que ya pasamos la
    # última materia y empezó la fórmula de cierre del analítico.
    fin_documento_re = re.compile(r'certificado\s+en\s+', re.IGNORECASE)
    
    lineas_ignorar = [
        r'^Actividades\s+(Rendidas|Cursadas)',
        r'^Resultado\s+Año\s+Periodo',
        r'^Fecha\s+Nota',
        r'^A\s+pedido\s+del\s+interesado',
        r'^se\s+expide\s+el\s+presente',
        r'^QUIEN\s+CORRESPONDA',
        r'^Página\s+\d+\s+de\s+\d+',
        r'^Certificado\s+[Aa]nalítico',
    ]
    
    def es_linea_ignorar(linea):
        for patron in lineas_ignorar:
            if re.search(patron, linea, re.IGNORECASE):
                return True
        return False
    
    for line in data_lines:
        clean_line = line.strip()
        if not clean_line:
            continue
        
        # Si detectamos "certificado en <CIUDAD>" es el cierre del documento:
        # cortamos acá. Pero ojo: la línea puede tener parte del nombre de la
        # última materia ANTES de esa frase (cuando el PDF las junta en un
        # mismo renglón). En ese caso, recortamos hasta esa frase y lo que
        # queda lo procesamos normalmente; después del break, listo.
        fin_match = fin_documento_re.search(clean_line)
        if fin_match:
            recorte = clean_line[:fin_match.start()].strip()
            if recorte and not es_linea_ignorar(recorte) and not subject_start_re.match(recorte):
                # Es continuación de la materia anterior: agregarla antes de la fecha
                if registro_actual:
                    fecha_match = re.search(r'\b\d{2}/\d{2}/\d{4}\b', registro_actual)
                    if fecha_match:
                        pos_fecha = fecha_match.start()
                        registro_actual = registro_actual[:pos_fecha] + recorte + " " + registro_actual[pos_fecha:]
                    else:
                        registro_actual += " " + recorte
            break
        
        if es_linea_ignorar(clean_line):
            continue
        
        if subject_start_re.match(clean_line):
            if registro_actual:
                registros.append(registro_actual)
            registro_actual = clean_line
        else:
            if registro_actual:
                tiene_fecha_registro = bool(re.search(r'\b\d{2}/\d{2}/\d{4}\b', registro_actual))
                tiene_fecha_linea = bool(re.search(r'\b\d{2}/\d{2}/\d{4}\b', clean_line))
                
                if not tiene_fecha_registro and not tiene_fecha_linea:
                    registro_actual += " " + clean_line
                elif tiene_fecha_registro and not tiene_fecha_linea:
                    fecha_match = re.search(r'\b\d{2}/\d{2}/\d{4}\b', registro_actual)
                    if fecha_match:
                        pos_fecha = fecha_match.start()
                        registro_actual = registro_actual[:pos_fecha] + clean_line + " " + registro_actual[pos_fecha:]
                    else:
                        registro_actual += " " + clean_line
                else:
                    registro_actual += " " + clean_line
            else:
                registro_actual = clean_line
                
    if registro_actual:
        registros.append(registro_actual)
    
    # 4. Normalizar registros
    normalized_records = []
    for reg in registros:
        reg = reg.replace('\n', ' ').replace('\r', ' ')
        reg = " ".join(reg.split())
        normalized_records.append(reg)
    
    # 5. Limpiar registros
    processed_records = [limpiar_registro(reg) for reg in normalized_records]
    
    # 6. Extraer campos
    extracted_rows = []
    for rec in processed_records:
        fields = extract_fields(rec)
        if not fields:
            m = re.match(r'^([A-Za-z0-9].+)$', rec)
            if m:
                fields = {
                    "actividades": m.group(1).strip(),
                    "fecha": "",
                    "col_c": "",
                    "col_d": "",
                    "col_e": "",
                    "col_f": "",
                    "col_g": ""
                }
            else:
                msgbox("No se pudo parsear el registro:\n" + rec[:150])
        if fields:
            extracted_rows.append(fields)
    
    # 7. Pegar los datos personales en las hojas correspondientes
    try:
        editor_sheet = doc.getSheets().getByName("EDITOR")
        # DNI en R2
        editor_sheet.getCellRangeByName("R2").setString(dni if dni else "DNI no encontrado")
        # Apellido en R4 (solo si se encontró, para no pisar ediciones manuales con vacío)
        if apellido:
            editor_sheet.getCellRangeByName("R4").setString(apellido)
        # Nombre(s) en S4
        if nombres:
            editor_sheet.getCellRangeByName("S4").setString(nombres)
    except Exception as e:
        msgbox("Error accediendo a la hoja 'EDITOR':\n" + str(e))
    
    # Género en Datos!V4 (celda enlazada al desplegable "el Sr."/"la Srta.")
    if genero:
        try:
            datos_sheet = doc.getSheets().getByName("Datos")
            datos_sheet.getCellRangeByName("V4").setString(genero)
        except Exception as e:
            msgbox("Error accediendo a la hoja 'Datos':\n" + str(e))
    
    # 8. Pegar la tabla en la hoja "Extractor"
    try:
        extractor_sheet = doc.getSheets().getByName("Extractor")
        data_array = []
        for record in extracted_rows:
            row_data = [
                record.get("actividades", "").strip(),
                record.get("fecha", "").strip(),
                record.get("col_c", "").strip(),
                record.get("col_d", "").strip(),
                record.get("col_e", "").strip(),
                record.get("col_f", "").strip(),
                record.get("col_g", "").strip()
            ]
            data_array.append(row_data)
        
        if data_array:
            num_rows = len(data_array)
            num_cols = 7
            cell_range = extractor_sheet.getCellRangeByPosition(0, 0, num_cols - 1, num_rows - 1)
            data_tuple = tuple(tuple(row) for row in data_array)
            cell_range.setDataArray(data_tuple)
        else:
            msgbox("No se extrajeron registros para pegar en 'Extractor'.")
    except Exception as e:
        msgbox("Error accediendo a la hoja 'Extractor':\n" + str(e))
    
    msgbox("Extracción finalizada.")
