import uno
import re
import pdfplumber
from urllib.parse import urlparse, unquote

def uno_url_to_path(url):
    """
    Convierte una URL de LibreOffice (file://...) a una ruta de sistema.
    """
    parsed = urlparse(url)
    return unquote(parsed.path)

def msgbox(message):
    """
    Muestra un cuadro de diálogo simple en LibreOffice.
    """
    ctx = uno.getComponentContext()
    smgr = ctx.ServiceManager
    toolkit = smgr.createInstanceWithContext("com.sun.star.awt.Toolkit", ctx)
    box = toolkit.createMessageBox(
        None,
        uno.Enum("com.sun.star.awt.MessageBoxType", "INFOBOX"),
        1,
        "Información",
        message
    )
    box.execute()

def limpiar_registro(record):
    """
    Limpia el registro removiendo patrones no deseados derivados de cortes de página,
    numeración o indicaciones del certificado (como "estudios cursados" o "actividades cursadas").
    
    Primero, se preserva el prefijo si el registro inicia con un código y guión (por ejemplo, "16273 - ").
    Luego se ejecuta:
      1. Reensamblaje en caso de corte de página.
      2. Eliminación de restos aislados de numeración.
      3. Recorte del registro en caso de detectar indicadores como "estudios cursados" o "actividades cursadas".
    Finalmente, se reensambla el prefijo preservado más el resto del registro limpio.
    """
    # Preservar el prefijo con código y guión si existe
    prefix = ""
    prefix_match = re.match(r'^([A-Za-z0-9]+(?:\s*-\s*))', record)
    if prefix_match:
        prefix = prefix_match.group(1)
        record = record[len(prefix):]
    
    # 1. Reensamblar registro si hay corte por página
    if "Página" in record and "Certificado analitico" in record:
        pattern = re.compile(
            r'^(?P<subject1>.+?)\s*Página\s+\d+\s+de\s+\d+\s*-\s*Certificado\s+analitico\s+de\s+.*?\)\s*(?P<subject2>.+)$',
            flags=re.IGNORECASE
        )
        m = pattern.search(record)
        if m:
            record = m.group("subject1").strip() + " " + m.group("subject2").strip()
    
    # 2. Eliminar patrones aislados de numeración de página
    record = re.sub(r'Página\s+\d+\s+de\s+\d+', '', record, flags=re.IGNORECASE)
    
    # 3. Recortar el registro si se encuentran palabras clave de certificado
    footer_indicators = ["estudios cursados", "actividades cursadas"]
    for indicator in footer_indicators:
        pos = record.lower().find(indicator)
        if pos != -1:
            record = record[:pos].strip()
            break

    # 4. Si no se halla una fecha, también recortar en base a otros indicadores
    if not re.search(r'\b\d{2}/\d{2}/\d{4}\b', record):
        footer_keywords = [
            "resultado", "a pedido del interesado", "se expide",
            "certificado analitico", "sello", "firma"
        ]
        for kw in footer_keywords:
            pos = record.lower().find(kw.lower())
            if pos != -1:
                record = record[:pos].strip()
                break
    
    cleaned = " ".join(record.split())
    return prefix + cleaned

def extract_fields(record):
    """
    Extrae los campos del registro en 7 columnas:
    
    Formato 1 (Equivalencias):
      Columna A: Código-Nombre
      Columna B: Fecha
      Columna C: Aprobado/Ausente
      Columna D: Equivalencia
      Columna E: DFCNyCS número/año
      Columnas F-G: (vacías)
      
    Formato 2 (Exámenes/Promociones):
      Columna A: Código-Nombre
      Columna B: Fecha
      Columna C: Nota
      Columna D: Examen/Promoción
      Columna E: Acta
      Columna F: Libro
      Columna G: Folio
    """
    # Normalizar espacios múltiples primero
    record = " ".join(record.split())
    
    # Buscar la fecha
    date_match = re.search(r'\b(\d{2}/\d{2}/\d{4})\b', record)
    if not date_match:
        return None
    
    # Dividir en partes: antes de la fecha y después de la fecha
    actividades = record[:date_match.start()].strip()
    fecha = date_match.group(1)
    remainder = record[date_match.end():].strip()
    
    # Inicializar todos los campos
    col_c = ""  # Nota o Aprobado/Ausente
    col_d = ""  # Tipo (Examen/Promoción/Equivalencia)
    col_e = ""  # Acta o Resolución
    col_f = ""  # Libro
    col_g = ""  # Folio
    
    # Tokenizar el resto
    tokens = remainder.split()
    if not tokens:
        return None
    
    idx = 0
    
    # Detectar el tipo de registro
    if idx < len(tokens):
        # CASO 1: "Aprobado" o "Ausente" - puede ser Equivalencia o Examen
        if tokens[idx] in ["Aprobado", "Ausente"]:
            col_c = tokens[idx]
            idx += 1
            
            # Buscar el tipo: "Equivalencia" o "Examen" o "Promoción"
            if idx < len(tokens) and tokens[idx] in ["Equivalencia", "Examen", "Promoción"]:
                col_d = tokens[idx]
                idx += 1
                
                # Si es Equivalencia, buscar el patrón DFCNyCS
                if col_d == "Equivalencia":
                    # Buscar el patrón DFCNyCS seguido de número/año
                    resolucion_parts = []
                    if idx < len(tokens) and tokens[idx] == "DFCNyCS":
                        resolucion_parts.append(tokens[idx])
                        idx += 1
                        
                        # Capturar el número/año que sigue
                        while idx < len(tokens):
                            token = tokens[idx]
                            # Si contiene números o es una barra, es parte de la resolución
                            if re.search(r'\d', token) or token == "/":
                                resolucion_parts.append(token)
                                idx += 1
                                # Si ya encontramos el patrón completo número/año, salir
                                if re.search(r'\d+/\d+', " ".join(resolucion_parts)):
                                    break
                            else:
                                break
                        
                        col_e = " ".join(resolucion_parts)
                
                # Si es Examen o Promoción, buscar acta/libro/folio
                elif col_d in ["Examen", "Promoción"]:
                    if idx < len(tokens):
                        col_e = tokens[idx]  # Acta
                        idx += 1
                    if idx < len(tokens):
                        col_f = tokens[idx]  # Libro
                        idx += 1
                    if idx < len(tokens):
                        col_g = tokens[idx]  # Folio
                        idx += 1
            
        # CASO 2: Examen/Promoción - detectar nota numérica
        elif re.match(r'^\d+$', tokens[idx]) or re.match(r'^\d+\(', tokens[idx]):
            # Capturar la nota con su descripción en paréntesis si existe
            if re.match(r'^\d+$', tokens[idx]):
                col_c = tokens[idx]
                idx += 1
                # Buscar el texto en paréntesis (puede estar en uno o más tokens)
                paren_parts = []
                while idx < len(tokens):
                    if tokens[idx].startswith('('):
                        paren_parts.append(tokens[idx])
                        if tokens[idx].endswith(')'):
                            idx += 1
                            break
                        idx += 1
                    elif paren_parts and not tokens[idx-1].endswith(')'):
                        paren_parts.append(tokens[idx])
                        if tokens[idx].endswith(')'):
                            idx += 1
                            break
                        idx += 1
                    else:
                        break
                if paren_parts:
                    col_c += " " + " ".join(paren_parts)
            else:
                # La nota ya incluye el paréntesis
                col_c = tokens[idx]
                idx += 1
            
            # Buscar "Examen" o "Promoción"
            if idx < len(tokens) and tokens[idx] in ["Examen", "Promoción"]:
                col_d = tokens[idx]
                idx += 1
            
            # Los siguientes 3 tokens son acta, libro, folio
            if idx < len(tokens):
                col_e = tokens[idx]  # Acta
                idx += 1
            if idx < len(tokens):
                col_f = tokens[idx]  # Libro
                idx += 1
            if idx < len(tokens):
                col_g = tokens[idx]  # Folio
                idx += 1
    
    return {
        "actividades": actividades.strip(),
        "fecha": fecha,
        "col_c": col_c,
        "col_d": col_d,
        "col_e": col_e,
        "col_f": col_f,
        "col_g": col_g
    }

def ExtraerDatos(*args):
    ctx = uno.getComponentContext()
    smgr = ctx.ServiceManager
    desktop = smgr.createInstanceWithContext("com.sun.star.frame.Desktop", ctx)
    doc = desktop.getCurrentComponent()
    
    # 1. Seleccionar el PDF
    filePicker = smgr.createInstanceWithContext("com.sun.star.ui.dialogs.FilePicker", ctx)
    filePicker.setTitle("Seleccionar archivo PDF")
    filePicker.appendFilter("Archivos PDF (*.pdf)", "*.pdf")
    defaultDir = "file:///home/cristian/Documentos/ALUMNOS/Analitico%20p-titulo/PDFs%20y%20Excel%20para%20copiar"
    try:
        filePicker.setDisplayDirectory(defaultDir)
    except Exception:
        pass
    
    if filePicker.execute() != 1:
        msgbox("Operación cancelada. No se seleccionó ningún archivo.")
        return
    
    fileURLs = filePicker.getFiles()
    if not fileURLs or len(fileURLs) == 0:
        msgbox("No se seleccionó ningún archivo.")
        return
    
    fileUrl = fileURLs[0]
    filePath = uno_url_to_path(fileUrl)
    
    # 2. Abrir el PDF y extraer el texto (a partir del encabezado)
    try:
        pdf = pdfplumber.open(filePath)
    except Exception as e:
        msgbox("No se pudo abrir el PDF:\n" + str(e))
        return
    
    dni = None
    dni_pattern = re.compile(r'\( *DNI *(\d{8}) *\)', re.IGNORECASE)
    data_lines = []
    header_found = False
    
    for page in pdf.pages:
        page_text = page.extract_text() or ""
        if "Certificado Analítico Parcial" in page_text:
            header_found = True
        if header_found and dni is None:
            m = dni_pattern.search(page_text)
            if m:
                dni = m.group(1)
        lines = page_text.splitlines()
        if not data_lines:
            for i, line in enumerate(lines):
                if "Actividades Rendidas" in line and "Fecha" in line:
                    data_lines.extend(lines[i+1:])
                    break
        else:
            data_lines.extend(lines)
    pdf.close()
    
    if not header_found:
        msgbox("No se encontró la sección 'Certificado Analítico Parcial'.")
        return
    
    msgbox("Cantidad total de líneas recolectadas: " + str(len(data_lines)))
    
    # 3. Agrupar las líneas en registros.
    # Se asume que una línea que comienza con un código (ej.: "16273 -") indica inicio de registro.
    # MEJORA: Detectar líneas que son continuación del nombre (sin fecha) vs líneas con datos (con fecha)
    registros = []
    registro_actual = ""
    subject_start_re = re.compile(r'^[A-Za-z0-9]+(?:-[A-Za-z0-9]+)*\s*-\s*')
    
    for line in data_lines:
        clean_line = line.strip()
        if not clean_line:
            continue
        
        # Detectar si es inicio de un nuevo registro (tiene código y guión)
        if subject_start_re.match(clean_line):
            if registro_actual:
                registros.append(registro_actual)
            registro_actual = clean_line
        else:
            # Esta línea NO tiene código
            if registro_actual:
                # Verificar si el registro actual ya tiene fecha
                tiene_fecha_registro = bool(re.search(r'\b\d{2}/\d{2}/\d{4}\b', registro_actual))
                tiene_fecha_linea = bool(re.search(r'\b\d{2}/\d{2}/\d{4}\b', clean_line))
                
                if not tiene_fecha_registro and not tiene_fecha_linea:
                    # Esta línea es parte del nombre de la materia (sin fecha en ambos)
                    # La insertamos como parte del nombre, al final del texto actual
                    registro_actual += " " + clean_line
                else:
                    # Ya hay fecha en el registro o en esta línea, agregar normalmente
                    registro_actual += " " + clean_line
            else:
                registro_actual = clean_line
                
    if registro_actual:
        registros.append(registro_actual)
    
    msgbox("Cantidad de registros identificados: " + str(len(registros)))
    
    # DEBUG: Mostrar los primeros 3 registros para verificar la agrupación
    debug_msg = "DEBUG 1/3 - REGISTROS AGRUPADOS:\n\n"
    for i, reg in enumerate(registros[:3]):
        # Mostrar los primeros 200 caracteres
        preview = reg[:200] if len(reg) > 200 else reg
        debug_msg += f"REGISTRO {i+1}:\n{preview}\n"
        if len(reg) > 200:
            debug_msg += "...\n"
        debug_msg += "\n"
    msgbox(debug_msg)
    
    # 4. Normalizar registros: eliminar saltos de línea y espacios múltiples
    # Esto es crítico para nombres de materias que están en múltiples líneas
    normalized_records = []
    for reg in registros:
        # Reemplazar saltos de línea por espacios
        reg = reg.replace('\n', ' ').replace('\r', ' ')
        # Eliminar espacios múltiples
        reg = " ".join(reg.split())
        normalized_records.append(reg)
    
    # 5. Aplicar limpieza de cabeceras, numeración y certificados
    processed_records = [limpiar_registro(reg) for reg in normalized_records]
    
    # DEBUG: Mostrar los primeros 3 registros DESPUÉS de limpiar
    debug_msg2 = "DEBUG 2/3 - DESPUÉS DE LIMPIAR:\n\n"
    for i, reg in enumerate(processed_records[:3]):
        preview = reg[:200] if len(reg) > 200 else reg
        debug_msg2 += f"REGISTRO {i+1}:\n{preview}\n"
        if len(reg) > 200:
            debug_msg2 += "...\n"
        debug_msg2 += "\n"
    msgbox(debug_msg2)
    
    # 6. Extraer los campos de cada registro
    extracted_rows = []
    for rec in processed_records:
        fields = extract_fields(rec)
        if not fields:
            # Fallback: si el registro inicia con un código se asume que es solo el nombre de la materia.
            m = re.match(r'^([A-Za-z0-9].+)$', rec)
            if m:
                fields = {
                    "actividades": m.group(1).strip(),
                    "fecha": "",
                    "col_c": "",
                    "col_d": "",
                    "col_e": "",
                    "col_f": "",
                    "col_g": ""
                }
            else:
                msgbox("No se pudo parsear el registro:\n" + rec[:150])
        if fields:
            extracted_rows.append(fields)
    
    msgbox("Se parsearon " + str(len(extracted_rows)) + " registros de datos.")
    
    # DEBUG: Mostrar los primeros 3 registros extraídos
    debug_msg3 = "DEBUG 3/3 - CAMPOS EXTRAÍDOS:\n\n"
    for i, fields in enumerate(extracted_rows[:3]):
        actividades = fields.get('actividades', '')
        act_preview = actividades[:100] if len(actividades) > 100 else actividades
        debug_msg3 += f"REGISTRO {i+1}:\n"
        debug_msg3 += f"  Materia: {act_preview}"
        if len(actividades) > 100:
            debug_msg3 += "..."
        debug_msg3 += f"\n  Fecha: {fields.get('fecha', '')}\n"
        debug_msg3 += f"  Col C: {fields.get('col_c', '')}\n"
        debug_msg3 += f"  Col D: {fields.get('col_d', '')}\n\n"
    msgbox(debug_msg3)
    
    # 6. Pegar el DNI en la hoja "EDITOR" (celda R2)
    try:
        editor_sheet = doc.getSheets().getByName("EDITOR")
        rango_editor = editor_sheet.getCellRangeByName("R2")
        rango_editor.setString(dni if dni else "DNI no encontrado")
    except Exception as e:
        msgbox("Error accediendo a la hoja 'EDITOR':\n" + str(e))
    
    # 7. Pegar la tabla en la hoja "Extractor" (a partir de la celda A1)
    try:
        extractor_sheet = doc.getSheets().getByName("Extractor")
        data_array = []
        for record in extracted_rows:
            row_data = [
                record.get("actividades", "").strip(),
                record.get("fecha", "").strip(),
                record.get("col_c", "").strip(),
                record.get("col_d", "").strip(),
                record.get("col_e", "").strip(),
                record.get("col_f", "").strip(),
                record.get("col_g", "").strip()
            ]
            data_array.append(row_data)
        
        if data_array:
            num_rows = len(data_array)
            num_cols = 7  # Columnas A a G
            cell_range = extractor_sheet.getCellRangeByPosition(0, 0, num_cols - 1, num_rows - 1)
            data_tuple = tuple(tuple(row) for row in data_array)
            cell_range.setDataArray(data_tuple)
        else:
            msgbox("No se extrajeron registros para pegar en 'Extractor'.")
    except Exception as e:
        msgbox("Error accediendo a la hoja 'Extractor':\n" + str(e))
    
    msgbox("Extracción finalizada.")
